# Copy this to ops/secrets/proton-bridge.env and fill it with Proton Bridge
# mailbox details from the Bridge app. Do not use the Proton login password.

PROTON_BRIDGE_IMAP_HOST=127.0.0.1
PROTON_BRIDGE_IMAP_PORT=
PROTON_BRIDGE_IMAP_SECURITY=
PROTON_BRIDGE_SMTP_HOST=127.0.0.1
PROTON_BRIDGE_SMTP_PORT=
PROTON_BRIDGE_SMTP_SECURITY=
PROTON_BRIDGE_USERNAME=
PROTON_BRIDGE_PASSWORD=
PROTON_BRIDGE_FROM_EMAIL=
PROTON_BRIDGE_FROM_NAME=
